{
  "name": "vivabairro-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:local": "tsx src/local-db.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests",
    "format": "prettier --write src tests *.json *.js",
    "format:check": "prettier --check src tests *.json *.js",
    "jobs:run": "tsx src/run-jobs.ts",
    "demo:refresh": "tsx src/demo-refresh.ts",
    "admin:bootstrap": "tsx src/bootstrap-admin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "nodemailer": "^10.4.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
